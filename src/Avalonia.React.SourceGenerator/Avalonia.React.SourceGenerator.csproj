<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishTrimmed;SelfContained;RuntimeIdentifier">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <PackageId>Avalonia.React.SourceGenerator</PackageId>
    <Version>$(AvaloniaReactVersion)</Version>
    <Authors>Avalonia.React contributors</Authors>
    <Description>Generates C# API interfaces from TypeScript declaration files for Avalonia.React.</Description>
    <PackageTags>Avalonia;React;TypeScript;SourceGenerator</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/oniemiddle/Avalonia.React</RepositoryUrl>
    <PackageProjectUrl>https://github.com/oniemiddle/Avalonia.React</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Analyzer-only package: there is no build output to put in a symbols package. -->
    <IncludeSymbols>false</IncludeSymbols>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\packages</PackageOutputPath>
    <!-- Analyzer projects must not inherit the application's trimming/publish settings. -->
    <PublishTrimmed>false</PublishTrimmed>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
    <None Include="$(TargetPath)" Pack="true" PackagePath="analyzers\dotnet\cs\Avalonia.React.SourceGenerator.dll" Visible="false" />
    <None Update="build\Avalonia.React.SourceGenerator.props" Pack="true" PackagePath="buildTransitive\Avalonia.React.SourceGenerator.props" />
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
</Project>

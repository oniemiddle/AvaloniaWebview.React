<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Avalonia.React</AssemblyName>
    <RootNamespace>Avalonia.React</RootNamespace>
    <PackageId>Avalonia.React</PackageId>
    <Version>$(AvaloniaReactVersion)</Version>
    <Authors>Avalonia.React contributors</Authors>
    <Description>Build React frontends hosted in Avalonia 12 using Avalonia's native WebView and a typed JavaScript bridge.</Description>
    <PackageTags>Avalonia;React;WebView;Hybrid;TypeScript</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/oniemiddle/Avalonia.React</RepositoryUrl>
    <PackageProjectUrl>https://github.com/oniemiddle/Avalonia.React</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\packages</PackageOutputPath>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Controls.WebView" Version="$(AvaloniaVersion)" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="LICENSE" />
    <None Include="build\Avalonia.React.targets" Pack="true" PackagePath="buildTransitive\Avalonia.React.targets" />
    <InternalsVisibleTo Include="Avalonia.React.Tests" />
  </ItemGroup>
</Project>

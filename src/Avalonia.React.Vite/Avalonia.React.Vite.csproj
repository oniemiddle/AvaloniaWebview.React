<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Avalonia.React.Vite</PackageId>
    <Version>0.1.3</Version>
    <Authors>Avalonia.React contributors</Authors>
    <Description>Vite development server integration for Avalonia.React desktop apps.</Description>
    <PackageTags>Avalonia;React;Vite;WebView;Build</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\packages</PackageOutputPath>
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>
  <ItemGroup>
    <None Update="build\Avalonia.React.Vite.targets" Pack="true" PackagePath="buildTransitive\Avalonia.React.Vite.targets" />
    <None Include="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>

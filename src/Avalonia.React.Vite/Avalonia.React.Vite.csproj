<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Avalonia.React.Vite</PackageId>
    <Version>$(AvaloniaReactVersion)</Version>
    <Authors>Avalonia.React contributors</Authors>
    <Description>Vite development server integration for Avalonia.React desktop apps.</Description>
    <PackageTags>Avalonia;React;Vite;WebView;Build</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/oniemiddle/Avalonia.React</RepositoryUrl>
    <PackageProjectUrl>https://github.com/oniemiddle/Avalonia.React</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\packages</PackageOutputPath>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Targets-only package: there is no build output to put in a symbols package. -->
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>
  <ItemGroup>
    <None Update="build\Avalonia.React.Vite.targets" Pack="true" PackagePath="buildTransitive\Avalonia.React.Vite.targets" />
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>

{
  "name": "@avalonia-react/bridge",
  "version": "0.1.0",
  "description": "TypeScript bridge for hosting React inside Avalonia.React",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oniemiddle/Avalonia.React.git",
    "directory": "client"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "avalonia",
    "react",
    "webview",
    "bridge"
  ],
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/bridge.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}

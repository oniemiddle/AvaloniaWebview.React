{
  "name": "@avalonia-react/bridge",
  "version": "0.17.0",
  "description": "TypeScript bridge for hosting React inside AvaloniaWebview.React",
  "license": "MIT",
  "author": "AvaloniaWebview.React contributors",
  "homepage": "https://github.com/oniemiddle/AvaloniaWebview.React#readme",
  "bugs": {
    "url": "https://github.com/oniemiddle/AvaloniaWebview.React/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oniemiddle/AvaloniaWebview.React.git",
    "directory": "client"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "avalonia",
    "react",
    "webview",
    "bridge",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/bridge.test.mjs test/ssr.test.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run verify:package"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}

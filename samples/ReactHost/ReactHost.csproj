<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <AssemblyName>ReactHost</AssemblyName>
    <RootNamespace>ReactHost</RootNamespace>
    <!-- The compatibility manifest is only required by the Windows WebView2 host. -->
    <ApplicationManifest Condition="'$(TargetFramework)' == 'net10.0-windows'">app.manifest</ApplicationManifest>
    <AvaloniaReactProjectDirectory>$(MSBuildProjectDirectory)\..\react-app</AvaloniaReactProjectDirectory>
    <AvaloniaReactDevServerDirectory>$(MSBuildProjectDirectory)\..\react-app</AvaloniaReactDevServerDirectory>
    <AvaloniaReactDevServerWarmupPath>src/main.tsx</AvaloniaReactDevServerWarmupPath>
    <AvaloniaReactBridgeDirectory>$(MSBuildProjectDirectory)\..\..\client</AvaloniaReactBridgeDirectory>
    <AvaloniaReactEmbeddedAssets>true</AvaloniaReactEmbeddedAssets>
    <!-- Debug serves the live Vite app; building the production bundle on every F5 is redundant. -->
    <AvaloniaReactBuildOnBuild Condition="'$(Configuration)' == 'Debug'">false</AvaloniaReactBuildOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Semi.Avalonia" Version="12.1.0.1" />
    <ProjectReference Include="..\..\src\AvaloniaWebview.React\AvaloniaWebview.React.csproj" />
    <ProjectReference Include="..\..\src\AvaloniaWebview.React.SourceGenerator\AvaloniaWebview.React.SourceGenerator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="..\react-app\src\FrontendApi.d.ts" />
  </ItemGroup>
  <!-- Native AOT publish: SkiaSharp/HarfBuzz native packages ship large .pdb files that the
       runtime never loads. Keep the published folder lean for a Release build. -->
  <Target Name="ReactHostRemovePublishSymbols"
          AfterTargets="ComputeFilesToPublish"
          Condition="'$(PublishAot)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <Import Project="..\..\src\AvaloniaWebview.React\build\AvaloniaWebview.React.targets" />
  <Import Project="..\..\src\AvaloniaWebview.React.Vite\build\AvaloniaWebview.React.Vite.targets" />
</Project>

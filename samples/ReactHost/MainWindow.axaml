<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:react="using:Avalonia.React"
        x:Class="ReactHost.MainWindow"
        Title="Avalonia + React"
        Width="1100"
        Height="760"
        Background="{DynamicResource SemiColorBackground0}">
  <!-- ReactHostView supplies the loading/error overlay and enables the Windows composition needed
       to render it above WebView2. WaitForBridgeReady hides the overlay after the React client
       calls signalReady(), with a fallback timeout. -->
  <react:ReactHostView x:Name="ReactHost"
                       SourceMode="Auto"
                       WaitForBridgeReady="True"
                       BridgeReadyTimeout="0:0:10"
                       LoadingText="正在启动 Avalonia + React…"
                       RetryText="重试加载"
                       ErrorTextFormat="页面加载失败：{0}"
                       MessageReceived="HandleMessageReceived"
                       Background="{DynamicResource SemiColorBackground0}" />
</Window>

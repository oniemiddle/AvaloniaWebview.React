<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:react="using:Avalonia.React"
        x:Class="ReactHost.MainWindow"
        Title="Avalonia + React"
        Width="1100"
        Height="760">
  <Grid>
    <react:AvaloniaReactWebView x:Name="ReactView" />

    <!-- NativeWebView uses an offscreen WebView2 surface on Windows so Avalonia can render this overlay above it. -->
    <Border x:Name="LoadingOverlay"
            Background="#F5F7FB"
            IsVisible="True">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="16">
        <Border Width="56"
                Height="56"
                CornerRadius="28"
                Background="#E5EEFF"
                HorizontalAlignment="Center">
          <TextBlock Text="A"
                     FontSize="28"
                     FontWeight="Bold"
                     Foreground="#3978E8"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="正在启动 Avalonia + React"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#202938"
                   HorizontalAlignment="Center" />
        <ProgressBar x:Name="LoadingIndicator"
                     Width="240"
                     Height="5"
                     IsIndeterminate="True" />
        <TextBlock x:Name="LoadingDetail"
                   Text="正在初始化 WebView…"
                   FontSize="13"
                   Foreground="#667085"
                   HorizontalAlignment="Center" />
        <Button x:Name="RetryButton"
                Content="重试加载"
                Foreground="#3978E8"
                HorizontalAlignment="Center"
                IsVisible="False"
                Click="RetryButton_OnClick" />
      </StackPanel>
    </Border>
  </Grid>
</Window>

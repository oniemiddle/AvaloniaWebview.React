<?xml version="1.0" encoding="utf-8"?>
<!--
  Native AOT publish profile for the Avalonia + React sample.

  Usage:
    dotnet publish samples/ReactHost/ReactHost.csproj -p:PublishProfile=win-x64-aot -f net10.0-windows
    pwsh -NoProfile -ExecutionPolicy Bypass -File eng/publish-aot.ps1   (adds prerequisite checks)

  Properties in a publish profile are project-local, so PublishAot does not flow into
  ProjectReference builds (the netstandard2.0 source generator would otherwise fail with
  NETSDK1207 "target framework does not support ahead-of-time compilation").
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\artifacts\publish\ReactHost-win-x64-aot\</PublishDir>

    <!-- Native AOT -->
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <!-- Avalonia's Win32 backend and the WebView2 host use COM interop. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>

    <!-- Not a single-file app: the wwwroot frontend and the native dependencies stay next to the exe. -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <DebugType>none</DebugType>
    <StripSymbols>true</StripSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Release asset pipeline: build the Vite app and copy dist/ to wwwroot in the publish dir. -->
    <AvaloniaReactBuildOnBuild>true</AvaloniaReactBuildOnBuild>
    <AvaloniaReactEmbeddedAssets>true</AvaloniaReactEmbeddedAssets>
  </PropertyGroup>
</Project>
